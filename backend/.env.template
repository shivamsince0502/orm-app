# Follow-Up Queue backend — env template.
# Copy to `backend/.env`, fill in the placeholder values, then recreate the backend container:
#   cp backend/.env.template backend/.env
#   docker rm -f followup-queue-backend && docker run -d --name followup-queue-backend \
#     --network followup-queue-net -p 8010:8010 --env-file backend/.env \
#     -v "$PWD":/app followup-queue-backend
# NOTE: no quotes, no inline comments — docker --env-file takes values literally.

# --- Database (container talks to its network peer; host port is 5433)
DB_NAME=followup
DB_USER=followup
DB_PASSWORD=<your-postgres-password>
DB_HOST=followup-queue-db
DB_PORT=5432

# --- LLM: hosted models via Ollama Cloud (OpenAI-compatible endpoint)
# Create a key at https://ollama.com/settings/keys · catalog: https://ollama.com/library
# Models: gpt-oss:20b (fast) · gpt-oss:120b (stronger) · gemma4:31b · nemotron-3-nano:30b/super/ultra
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:20b
LLM_API_KEY=<your-ollama-cloud-api-key>
# gpt-oss is a reasoning model: "low" keeps it fast; leave empty for models that reject the parameter
LLM_REASONING_EFFORT=low

# --- Email sender
DEFAULT_FROM_EMAIL=<your-sender-email@gmail.com>
# Real SMTP delivery when EMAIL_HOST is set (empty => console backend, mails in `docker logs`)
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=<your-sender-email@gmail.com>
# Gmail: enable 2FA, create an App Password (16 chars, no spaces)
EMAIL_HOST_PASSWORD=<your-app-password>
# 0 locally (HTTP); 1 only behind HTTPS — otherwise the login cookie never gets sent
SESSION_COOKIE_SECURE=0
